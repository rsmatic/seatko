PORT=4000
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=data/seatko.db
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173

# SeatKo owner (platform super-admin), created on first start if none exists.
# Leave OWNER_PASSWORD empty to generate one into data/owner-password.txt.
OWNER_EMAIL=owner@seatko.local
OWNER_PASSWORD=
OWNER_NAME=SeatKo Owner

# Admin of the demo organizer created by `npm run seed`
ADMIN_EMAIL=admin@seatko.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator
